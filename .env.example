# Copy this file to .env and fill only the services you enable.
# Never commit the real .env file.

APP_ENV=development
LOG_LEVEL=INFO

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed browser origins for CORS (the Vite dev server).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# Local development uses a file database and does not need a separate service.
DATABASE_URL=sqlite+aiosqlite:///./artifacts/agrovision.db
# These values are used only by the optional Docker/PostgreSQL profile.
POSTGRES_USER=agrovision
POSTGRES_PASSWORD=change-me-before-docker-start
POSTGRES_DB=agrovision

# --- Auth / JWT ---
# Generate a real secret for any shared environment, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-in-production-use-a-32-byte-random-hex
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7

# --- Model ---
# `auto` selects MPS on Apple Silicon, CUDA on NVIDIA, and CPU in Docker.
MODEL_DEVICE=auto
# Selected best checkpoint. The API refuses a missing/tampered artifact by default.
DETECTOR_MODEL_PATH=artifacts/training/yolo26n-aerial-sheep-v1/weights/best.pt
DETECTOR_MODEL_VERSION=yolo26n-aerial-sheep-v1-best-e10
DETECTOR_MODEL_SHA256=29561fa0c96052b9efac892a1dd4a6418508992f4c882b661d08afe5ba124e0d
DETECTOR_ALLOW_FALLBACK=false
DETECTOR_FALLBACK_CHECKPOINT=yolo26n.pt
DETECTOR_TARGET_CLASS=sheep
DETECTOR_INFERENCE_FLOOR=0.25
DETECTOR_CONFIDENCE_THRESHOLD=0.40
DETECTOR_IMAGE_SIZE=640
DETECTOR_QUEUE_CAPACITY=8
DETECTOR_QUEUE_WAIT_SECONDS=5
DETECTOR_INFERENCE_TIMEOUT_SECONDS=600

# --- Uploads ---
MAX_UPLOAD_MB=100
MAX_IMAGE_PIXELS=50000000
STORAGE_ROOT=artifacts/uploads
DEMO_ARTIFACTS_ROOT=artifacts/demo_predictions

# --- Video inference ---
VIDEO_MAX_PROCESSED_FRAMES=600
VIDEO_KEYFRAMES=8

# --- Streaming (simulated drone feeds) ---
STREAMS_CONFIG_PATH=configs/app.toml
# Process every Nth frame per stream to bound latency across multiple feeds.
STREAM_FRAME_STRIDE=3
STREAM_JPEG_QUALITY=75
# Target published frames per second per stream (simulated real-time pacing).
STREAM_TARGET_FPS=8
RTSP_OPEN_TIMEOUT_MS=5000
RTSP_READ_TIMEOUT_MS=5000
RTSP_RECONNECT_SECONDS=2

# --- Dataset providers (needed only for the corresponding download command) ---
ROBOFLOW_API_KEY=
HF_TOKEN=

# --- Optional experiment tracking ---
MLFLOW_TRACKING_URI=file:./mlruns
WANDB_API_KEY=
